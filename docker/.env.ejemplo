# ========= Configuración del ERP en tu computadora =========
# Copia este archivo a la carpeta principal con el nombre ".env" y cambia los valores marcados.

APP_NAME="ERP CUOP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FAKER_LOCALE=es_MX
ERP_PUERTO=8080

# CAMBIAR: dos contraseñas largas distintas para la base de datos (solo letras y números).
DB_PASSWORD=CAMBIAR_contrasena_base_1
DB_ROOT_PASSWORD=CAMBIAR_contrasena_base_2

# CAMBIAR: tu usuario administrador (se crea solo en el primer arranque).
ADMIN_NOMBRE="Tu nombre"
ADMIN_EMAIL=tu_correo@cuop.edu.mx
ADMIN_PASSWORD=CAMBIAR_contrasena_de_entrada

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Correo para enviar recibos (opcional). Con "log" no envía nada.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=caja@cuop.edu.mx
MAIL_FROM_NAME="CUOP Caja"

# WhatsApp e IA: apagados (ver docs/INSTALACION.md §9)
WHATSAPP_DRIVER=log
WHATSAPP_RECORDATORIOS=false
CHATBOT_IA=false
